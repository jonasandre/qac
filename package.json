{
  "name": "qac-monorepo",
  "private": true,
  "version": "0.2.3",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "bunx tsc --noEmit -p packages/core && bunx tsc --noEmit -p packages/cli && bunx tsc --noEmit -p packages/mcp",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build:local": "bun build packages/cli/src/index.ts --compile --outfile dist/qac"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  }
}
